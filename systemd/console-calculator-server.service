[Unit]
Description=Console Calculator Server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=console-calculator
LogsDirectory=console-calculator
EnvironmentFile=-/etc/console-calculator/server.env
ExecStart=/usr/bin/calculator_server --config /etc/console-calculator/server.conf
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
